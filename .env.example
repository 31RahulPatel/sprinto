# Read by `docker compose` (via variable substitution) when running the fully containerized
# stack — e.g. on a deployment box. Copy this to `.env` next to docker-compose.yml and fill in
# real values. Never commit the real `.env` (it's gitignored).
#
# Not used by local `npm run dev` — that reads backend/.env and frontend/.env.local directly.

POSTGRES_PASSWORD=

# Required — generate with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# Evidence storage — real AWS S3. Keep S3_ENDPOINT on its own uncommented, empty line (as
# below) for real S3 — docker-compose.yml only falls back to the bundled MinIO container when
# this var is entirely ABSENT, which is what happens if you comment the line out instead of
# leaving it blank. Only give it a value to deliberately point at MinIO or another
# S3-compatible target.
S3_REGION=us-east-1
# Leave blank to use the EC2 instance's IAM role instead of a static key pair.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=

# Optional — only needed once you connect a real cloud account.
PLATFORM_AWS_ACCESS_KEY_ID=
PLATFORM_AWS_SECRET_ACCESS_KEY=
PLATFORM_AWS_PRINCIPAL_ARN=

# Optional — only needed if you connect Bitbucket.
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
BITBUCKET_CALLBACK_URL=http://localhost:3000/api/integrations/bitbucket/callback
