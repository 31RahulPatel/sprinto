DATABASE_URL="postgresql://postgres:postgres@localhost:5433/compliance_platform?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="generate-a-long-random-string-here"
PORT=4000

# Evidence file storage (real AWS S3 — leave S3_ENDPOINT unset; only set it if pointing at a
# self-hosted S3-compatible target like MinIO)
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# S3_ENDPOINT=""

# AES-256-GCM key used to encrypt CloudAccount credentials at rest (generate with `openssl rand -hex 32`)
ENCRYPTION_KEY=""

# The platform's own base AWS identity — this is the Principal that customer IAM roles trust,
# and the credentials used to actually call sts:AssumeRole into a connected CloudAccount's role.
PLATFORM_AWS_ACCESS_KEY_ID=""
PLATFORM_AWS_SECRET_ACCESS_KEY=""
PLATFORM_AWS_PRINCIPAL_ARN=""

# Bitbucket OAuth app credentials — register a new OAuth consumer under
# Bitbucket workspace settings → Settings → OAuth consumers. The consumer's callback URL
# must exactly match BITBUCKET_CALLBACK_URL below.
BITBUCKET_CLIENT_ID=""
BITBUCKET_CLIENT_SECRET=""
BITBUCKET_CALLBACK_URL="http://localhost:3000/api/integrations/bitbucket/callback"
